# Copy to .env.production and fill in EVERY value. Never commit the real file.

# --- Public hostnames: app.<DOMAIN> (web) and api.<DOMAIN> (API) ---
DOMAIN=example.com

# --- Laravel ---
APP_NAME=ArmorHub
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.example.com
# Generate with: docker run --rm armorhub-api php artisan key:generate --show
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Behind Caddy every request comes from the proxy; trust its X-Forwarded-For so per-IP rate limits
# see real visitor addresses. Safe here because only Caddy can reach the API container.
TRUSTED_PROXIES=*
# Extra browser origins allowed to call the API (normally none: the web app is same-origin).
CORS_ALLOWED_ORIGINS=
SANCTUM_TOKEN_EXPIRATION=10080

# --- Database (MySQL container above; DB_HOST is set by compose) ---
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=armorhub
DB_USERNAME=armorhub
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sessions / cache / queue need no extra services ---
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Web app URL (used in emailed links, and as the one trusted browser origin) ---
WEB_URL=https://app.example.com

# --- Email (password resets + order notifications). Use any SMTP provider. ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ArmorHub

# --- Platform ---
PLATFORM_CURRENCY=USD
PLATFORM_COMMISSION_PERCENTAGE=10
# Real card payments with Stripe Checkout. In the Stripe dashboard add a webhook
# endpoint  https://api.<DOMAIN>/api/webhooks/stripe  for the events
# checkout.session.completed and checkout.session.expired, and paste its signing secret.
PLATFORM_PAYMENT_GATEWAY=stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# "simulated" charges nobody and is REFUSED in production unless explicitly allowed
# (staging/demo only): set PLATFORM_PAYMENT_GATEWAY=simulated and the flag below to true.
PLATFORM_ALLOW_SIMULATED_PAYMENTS=false
