# Copy to .env.production and fill in EVERY value. Never commit the real file.

# --- Public hostnames: app.<DOMAIN> (web) and api.<DOMAIN> (API) ---
DOMAIN=example.com

# --- Laravel ---
APP_NAME=ArmorHub
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
# Generate with: docker run --rm armorhub-api php artisan key:generate --show
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Browser origin(s) allowed to call the API (the web app).
CORS_ALLOWED_ORIGINS=https://app.example.com
SANCTUM_TOKEN_EXPIRATION=10080

# --- Database (MySQL container above; DB_HOST is set by compose) ---
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=armorhub
DB_USERNAME=armorhub
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sessions / cache / queue need no extra services ---
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Platform ---
PLATFORM_CURRENCY=USD
PLATFORM_COMMISSION_PERCENTAGE=10
# "simulated" charges nobody and is REFUSED in production until a real
# gateway is integrated. Only set this to true for a staging/demo deploy.
PLATFORM_PAYMENT_GATEWAY=simulated
PLATFORM_ALLOW_SIMULATED_PAYMENTS=false
